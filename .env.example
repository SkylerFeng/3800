# Copy to .env; README shows explicit shell loading. External uploads disabled by default.
CAMERA_SOURCE=mock
TELEMETRY_SOURCE=mock
VISION_PROVIDER=mock
TTS_PROVIDER=mock
HAPTIC_OUTPUT=mock
MODEL_TIMEOUT_S=5
DISTANCE_TTL_S=3
FRAME_TTL_S=10
CRITICAL_M=0.5
WARNING_M=1.2
HYSTERESIS_M=0.1
HAPTIC_INTERVAL_S=1
UPLOAD_MAX_BYTES=5242880
# Allowed camera: mock/upload/esp32
# Allowed telemetry: mock/esp32
# Allowed vision: mock/unconfigured/openai_compatible/ollama
# API key is optional in mock/local modes; cloud services usually require it.

# Real vision: choose openai_compatible OR ollama independently of camera/telemetry.
# Default mock makes no network calls. Settings below take effect after restart.
# Compatible Chat Completions VISION API: base ends before /chat/completions.
VISION_API_BASE_URL=
VISION_API_MODEL=
VISION_API_KEY=
# Explicit opt-in required before sending image + question outside loopback.
ALLOW_EXTERNAL_VISION=false
# Ollama is limited to loopback; install/start it and a vision model yourself.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# For real inference, consider raising MODEL_TIMEOUT_S to e.g. 60.

# Navigation is independent from vision and telemetry. Real Amap is opt-in.
MAP_PROVIDER=mock
AMAP_API_KEY=
ALLOW_EXTERNAL_MAPS=false
MAP_TIMEOUT_S=10
LOCATION_TTL_S=15
LOCATION_MAX_ACCURACY_M=30
OFF_ROUTE_M=35
ROUTE_MAX_AGE_S=1800

# XIAO v3 device. To use live inputs choose CAMERA_SOURCE=esp32 and/or TELEMETRY_SOURCE=esp32.
ESP32_HOST=
ESP32_CAMERA_PORT=80
ESP32_TCP_PORT=9000
CAMERA_FPS=10
DEVICE_TIMEOUT_S=5
DEVICE_RETRY_S=2
IMU_TTL_S=2
# Choose HAPTIC_OUTPUT=esp32 to send requests from real distance readings.
HAPTIC_ACK_S=0.6
WARNING_PULSE_MS=150
CRITICAL_PULSE_MS=300
WARNING_INTENSITY=0.5
CRITICAL_INTENSITY=1

# Local speech. Install requirements-voice.txt and unpack Vosk model to use ASR_PROVIDER=vosk.
ASR_PROVIDER=unconfigured
VOSK_MODEL_PATH=
ASR_TIMEOUT_S=20
RECORDING_MAX_S=22
RECORDING_TTL_S=90
# Choose TTS_PROVIDER=espeak for Mandarin WAV playback in the browser.
TTS_BINARY=espeak-ng
TTS_VOICE=cmn
TTS_SPEED=155
TTS_TIMEOUT_S=6
# TTS_PROVIDER=piper uses the optional offline Mandarin model documented in docs/DEMO.md.
PIPER_MODEL_PATH=models/piper/zh_CN-huayan-medium.onnx
PIPER_LENGTH_SCALE=1.10
PIPER_SENTENCE_PAUSE_S=0.18

# Host acceptance bounds in metres. Set from the exact A22 variant and bench measurements.
SONAR_MIN_M=0.02
SONAR_MAX_M=20.0

# Optional localhost Mandarin TTS: TTS_PROVIDER=matcha
MATCHA_MODEL_DIR=models/matcha/matcha-icefall-zh-baker
MATCHA_VOCODER=models/matcha/vocos-22khz-univ.onnx
MATCHA_SPEED=0.95

# Foreground voice-assistant session lifetime in seconds.
ASSISTANT_SESSION_S=900
